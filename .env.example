# ==============================================================
# HỆ THỐNG ACADEMIC RAG - BIẾN MÔI TRƯỜNG (MẪU)
# ==============================================================

# 1. Ứng dụng Backend
PROJECT_NAME="Academic RAG Assistant"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=academic_rag_secret_key_change_me_in_production_12345

# 2. Cơ sở dữ liệu PostgreSQL
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=rag_password123
POSTGRES_DB=rag_academic_db

# 3. Object Storage MinIO (S3 Compatible)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password123
MINIO_BUCKET_NAME=academic-docs
MINIO_PUBLIC_URL=http://localhost:9000

# 4. Vector Database Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=academic_knowledge

# 5. Message Queue Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# 6. Mô hình AI Offline Ollama
# Trên Docker Windows, dùng host.docker.internal:11434 để gọi Ollama cài trên máy thật
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_LLM_MODEL=llama3.1:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
